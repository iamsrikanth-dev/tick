{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), display-capture=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/google-authenticator-on-pc",
      "destination": "/google-authenticator-on-pc.html"
    },
    {
      "source": "/authy-desktop-alternative",
      "destination": "/authy-desktop-alternative.html"
    }
  ],
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/google-authenticator-on-pc.html",
      "destination": "/google-authenticator-on-pc",
      "permanent": true
    },
    {
      "source": "/authy-desktop-alternative.html",
      "destination": "/authy-desktop-alternative",
      "permanent": true
    }
  ]
}
